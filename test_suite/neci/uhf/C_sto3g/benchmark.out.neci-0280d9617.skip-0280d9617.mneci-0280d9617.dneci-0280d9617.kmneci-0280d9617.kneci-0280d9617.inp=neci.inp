title

    system read
        electrons 4
        uhf zero-delimited
    endsys

    calc
        time 30
        # since this is a test, need it to be reproducible:
        load-balance-blocks off
        seed 9

        methods
            method vertex fcimc
        endmethods
        totalwalkers 1.e3
        # eq-cyc 15000
        nmcyc 15000
        definedet 1-2 3 5

        startsinglepart 100
        tau-values \
            start user-defined 0.01
        tau-search \
            algorithm conventional \
            stop-condition var-shift

        shiftdamp 0.1
        stepsshift 10

        truncinitiator
        addtoinitiator 3

        semi-stochastic 2
        allrealcoeff
        pops-core 2

        memoryfacspawn 50
    endcalc

  logging
        binarypops
        highlypopwrite 10000
        printorboccs
  endlog

end

