        start user-defined 0.01 \
        max 0.02
    tau-search \
        algorithm conventional \
        stop-condition var-shift \
        maxwalkerbloom 1
    memoryfacspawn 10.00
    memoryfacpart 5.00
    startsinglepart 10

endcalc

logging
    highlypopwrite 50
endlog
end

