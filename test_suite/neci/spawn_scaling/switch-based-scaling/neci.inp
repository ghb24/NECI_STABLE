Title

System read
    electrons 6
    nonuniformrandexcits guga-pchb localised
    nobrillouintheorem
    guga 0
    sym 0 0 0 0
    freeformat
endsys

calc
    definedet 1 3 6-7 10 12

    seed -1
    load-balance-blocks off

    methods
        method vertex fcimc
    endmethods

    # intentionally set a small psingles to have blooms
    psingles 0.01

    switch-based-scaling 2.0 0

    no-changeref

    totalwalkers     1.e3
    tau-values \
        ignore-diagonal-estimate \
        start user-defined 0.07

    diagshift 0.00
    target-shiftDamp 0.5
    stepsshift 10

    nmcyc 400

    allrealcoeff
    realspawncutoff 0.03

    memoryfacspawn 50
    memoryfacpart 30

    time 10000

    startsinglepart 100

endcalc

logging
    popsfile -1
endlog

end

