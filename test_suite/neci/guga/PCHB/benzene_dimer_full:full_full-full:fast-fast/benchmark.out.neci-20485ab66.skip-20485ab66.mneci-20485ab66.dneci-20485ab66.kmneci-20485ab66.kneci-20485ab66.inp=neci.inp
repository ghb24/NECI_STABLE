Title

System read
    electrons 12
    nobrillouintheorem
    FCIDUMP-name dimer.FciDmp
    freeformat
    nonuniformrandexcits guga-pchb \
        drawing full:full full-full:fast-fast \
        weighting rhf-expression initial-werner
    guga 0
    ignore-fcidump-header
endsys

calc
    seed 7
    load-balance-blocks off
    nmcyc 2e3

    definedet    1-6 13-18
    totalwalkers 1e4
    # semi-stochastic 1e4
    pops-core 1e5

    methods
        method vertex fcimc
    endmethods

    diagshift .5
    shiftdamp .02
    stepsshift 10
    proje-changeref 2.00
    truncinitiator
    addtoinitiator  3
    allrealcoeff
    realspawncutoff .30
    jump-shift
    tau-values \
        start user-defined 0.01 \
        # max 0.003
    tau-search \
        algorithm conventional \
        stop-condition off \
        maxwalkerbloom 2
    memoryfacspawn 100.00
    memoryfacpart 50.00
    startsinglepart 100

endcalc

logging
    highlypopwrite 50
    hdf5-pops
endlog
end

