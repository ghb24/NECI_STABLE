title

system read
    order-by-1elec-energy
    electrons 10
    nonuniformrandexcits guga-pchb \
        drawing unif:unif unif-unif:fast-fast \
        weighting uniform initial-dobrautz
    guga 0
endsys

calc
    time 30
    methods
        method vertex fcimc
    endmethods
    seed -7
    load-balance-interval 1000
    nmcyc 10000
    totalwalkers 10000
    tau-values \
        start user-defined 6.342713037945149E-003 \
        max 1.e-3
    tau-search \
        algorithm histogramming \
        stop-condition OFF \
        maxwalkerbloom 3.0
    startsinglepart 100
    truncinitiator
    addtoinitiator 3
    shiftdamp 0.03
    stepsshift 25
    jump-shift
    load-balance-blocks off
endcalc

integral
    freeze 2 0
endint

logging
    popsfile -1
endlog
end

