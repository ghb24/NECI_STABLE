        drawing full:full full-full:fast-fast \
        weighting abs-integral initial-dobrautz
    guga 0
    GAS-SPEC CUMULATIVE 4
        3  2  4
        3  5  7
        3  8 10
        3 12 12
        3*1 3*2 3*3 3*4
    ignore-fcidump-header
endsys

calc
    seed 7
    load-balance-blocks off

    nmcyc 1e3

    definedet    1  3  5 \
                 7  9 11 \
                14 16 18 \
                20 22 24
    totalwalkers 1e3
    semi-stochastic 5e2
