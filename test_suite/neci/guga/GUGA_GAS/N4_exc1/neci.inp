Title

System read
    electrons 12
    nobrillouintheorem
    FCIDUMP-name N4.FciDmp
    freeformat
    nonuniformrandexcits guga-gas-pchb \
        drawing unif:unif unif-unif:fast-fast \
        weighting uniform Initial-dobrautz
    guga 0
    GAS-SPEC LOCAL 4
        3 2 4
        3 2 4
        3 2 4
        3 2 4
        3*1 3*2 3*3 3*4
    ignore-fcidump-header
endsys

calc
    seed 7
    load-balance-blocks off
    nmcyc 1e3

    definedet    1  3  5 \
                 7  9 11 \
                14 16 18 \
                20 22 24
    totalwalkers 1e4
    semi-stochastic 1e6
    pops-core 1e5

    methods
        method vertex fcimc
    endmethods

    diagshift .5
    shiftdamp .02
    stepsshift 10
    proje-changeref 2.00
    truncinitiator
    addtoinitiator  3
    allrealcoeff
    realspawncutoff .30
    jump-shift
    tau-values \
        start user-defined 0.1
    tau-search \
        algorithm conventional \
        stop-condition off \
        maxwalkerbloom 2
    memoryfacspawn 100.00
    memoryfacpart 50.00
    startsinglepart 100

endcalc

logging
    highlypopwrite 50
    hdf5-pops
endlog
end
