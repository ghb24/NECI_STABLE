title

system read noorder
    electrons 10
    nobrillouintheorem
    nonhermitian 2-body
    nonuniformrandexcits pchb delocalised
endsys

calc
    methods
        method vertex fcimc
    endmethods
    nmcyc 10000
    seed -7
    totalwalkers 10000
    shiftdamp 0.1
    tau-values \
        start user-defined 0.001
    tau-search \
        algorithm conventional \
        stop-condition var-shift
    memoryfacpart 1.5
    memoryfacspawn 5.
    truncinitiator
    addtoinitiator 3
    allrealcoeff
    realspawncutoff 1.0
    avgrowthrate
    startsinglepart 10
    definedet 1-10
    load-balance-blocks OFF
    trial-wavefunction 100
    pops-trial 100
    # keyword under test:
    left-trial-evec
endcalc

logging
    popsfile -1
endlog
end
