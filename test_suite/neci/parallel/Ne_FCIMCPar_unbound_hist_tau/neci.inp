title

system read
    order-by-1elec-energy
    electrons 10
    nonuniformrandexcits 4ind-weighted-unbound
endsys

calc
    time 30
    methods
        method vertex fcimc
    endmethods

    seed -7
    load-balance-blocks off

    nmcyc 3500

    tau-values \
        start refdet-connections \
        max 0.02
    tau-search \
        algorithm histogramming 1e-3 1e5 1e4 \
        stop-condition off \
        maxwalkerbloom 3.0

    totalwalkers 20000
    startsinglepart
    truncinitiator
    addtoinitiator 3
    shiftdamp 0.03
    stepsshift 25
    jump-shift
endcalc

integral
    freeze 2 0
endint

logging
    popsfile -1
endlog
end
